# Copy to server/.env. Never commit real keys: .env is git-ignored.
PORT=4000
NODE_ENV=development

# Required in production: long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=12h

# Comma-separated origins allowed by CORS (only needed when the client runs on another origin).
CORS_ORIGIN=http://localhost:5173

# SQLite file and upload directory (defaults live under server/data/).
# DATABASE_PATH=./data/bookleaf.db
# UPLOAD_DIR=./data/uploads

# --- AI (OpenAI). Leave the key empty to run with the rules/template fallbacks only.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# Set to true to simulate an AI outage and exercise the graceful-degradation paths.
AI_DISABLED=false
